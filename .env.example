# Copy to .env and fill in. .env is gitignored.

# Required for the hosted models. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# "groq" (default) or "ollama" to run every agent on a local model.
# LLM_PROVIDER=groq
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Override the model of a single agent (defaults in backend/app/config.py), e.g.
# MODEL_COORDINATOR=openai/gpt-oss-120b
# MODEL_WRITER=openai/gpt-oss-120b
# MODEL_CRITIC=qwen/qwen3.8-27b

# Limits
# AGENT_TIMEOUT_S=240
# MAX_ACTIVE_RUNS=2
# DB_PATH=backend/data/runs.db
